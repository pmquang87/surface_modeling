# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
# Anchored to the repo root: an unanchored "build/"/"dist/" matches a directory
# of that name at ANY depth, so src/build/ or tests/fixtures/build/ silently
# disappears from git (stl2step FINDINGS-0 D5: an unanchored build*/ hid
# committed test data until a clean clone failed).
/dist/
/build/
*.egg

# Virtual environments
.venv/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Test / Coverage
.pytest_cache/
htmlcov/
.coverage
.tox/

# Distribution
*.whl
*.tar.gz

# CAD data (large binary files — don't commit to git)
*.SLDPRT
*.SLDASM
*.stp
*.STP
*.STEP
*.step
*.stl
*.STL
*.blend
*.blend1

# Temporary
*.log
*.tmp
